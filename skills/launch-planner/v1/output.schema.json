{
  "type": "object",
  "properties": {
    "release_name": { "type": "string" },
    "summary": { "type": "string" },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": { "type": "string", "enum": ["internal", "alpha", "beta", "early_access", "full"] },
          "goal": { "type": "string" },
          "actions": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["phase", "goal", "actions"],
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["owned", "rented", "borrowed"] },
          "channel": { "type": "string" },
          "role": { "type": "string" },
          "routes_to_owned": { "type": "string" }
        },
        "required": ["type", "channel", "role", "routes_to_owned"],
        "additionalProperties": false
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": { "type": "string" },
          "timing": { "type": "string", "enum": ["pre_launch", "launch_day", "post_launch"] },
          "when": { "type": "string" },
          "owner_role": { "type": "string" }
        },
        "required": ["task", "timing", "when", "owner_role"],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "source_field": { "type": "string" }
        },
        "required": ["claim", "source_field"],
        "additionalProperties": false
      }
    }
  },
  "required": ["release_name", "summary", "phases", "channels", "checklist", "claims"],
  "additionalProperties": false
}
